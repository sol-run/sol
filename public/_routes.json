{
  "version": 1,
  "include": ["/*"],
  "exclude": ["/_next/*", "/api/*", "/static/*", "/favicon.ico", "/robots.txt"],
  "routes": [
    {
      "src": "/blog/(?<id>[^/]+)/?$",
      "dest": "/blog/[id].html"
    },
    {
      "src": "/creator/(?<username>[^/]+)/?$",
      "dest": "/creator/[username].html"
    },
    {
      "src": "/edit-product/(?<id>[^/]+)/?$",
      "dest": "/edit-product/[id].html"
    },
    {
      "src": "/product-access/(?<id>[^/]+)/?$",
      "dest": "/product-access/[id].html"
    },
    {
      "src": "/product-files-view/(?<id>[^/]+)/?$",
      "dest": "/product-files-view/[id].html"
    },
    {
      "src": "/product-files/(?<id>[^/]+)/?$",
      "dest": "/product-files/[id].html"
    },
    {
      "src": "/product/(?<id>[^/]+)/?$",
      "dest": "/product/[id].html"
    }
  ]
}
